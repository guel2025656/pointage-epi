generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ENSEIGNANT_ITINERANT
  VOLONTAIRE
  CANEF
  CPPP
  IEPP
}

enum PorteeAdmin {
  NATIONALE
  SECTEUR
}

model Secteur {
  id        String   @id @default(cuid())
  nom       String   @unique
  sites     Site[]
  acteurs   Acteur[]
  admins    Admin[]
  createdAt DateTime @default(now())
}

model Site {
  id        String     @id @default(cuid())
  nom       String
  latitude  Float? // position GPS de référence du site, requise pour exiger la présence sur place
  longitude Float?
  secteurId String
  secteur   Secteur    @relation(fields: [secteurId], references: [id])
  acteurs   Acteur[]
  pointages Pointage[]
  createdAt DateTime   @default(now())

  @@unique([secteurId, nom])
}

model Acteur {
  id        String     @id @default(cuid())
  nom       String
  role      Role
  pin       String // code à 4 chiffres, hashé
  actif     Boolean    @default(true)
  secteurId String
  secteur   Secteur    @relation(fields: [secteurId], references: [id])
  siteId    String
  site      Site       @relation(fields: [siteId], references: [id])
  pointages Pointage[]
  absences  Absence[]
  createdAt DateTime   @default(now())
}

model Admin {
  id           String      @id @default(cuid())
  nom          String
  email        String      @unique
  passwordHash String
  portee       PorteeAdmin @default(SECTEUR)
  secteurId    String?
  secteur      Secteur?    @relation(fields: [secteurId], references: [id])
  createdAt    DateTime    @default(now())
}

model Pointage {
  id            String   @id @default(cuid())
  acteurId      String
  acteur        Acteur   @relation(fields: [acteurId], references: [id])
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id])
  date          DateTime @db.Date
  heureArrivee  String?
  heureDepart   String?
  latArrivee    Float?
  lngArrivee    Float?
  latDepart     Float?
  lngDepart     Float?
  creeHorsLigne Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([acteurId, date])
  @@index([siteId, date])
}

// Autorisation déjà accordée par l'IEPP en dehors de l'application : l'acteur
// se contente ici d'informer la période et les dispositions prises pour que
// les enfants ne perdent pas leur temps de travail. Pas de circuit de
// validation dans l'application.
model Absence {
  id           String   @id @default(cuid())
  acteurId     String
  acteur       Acteur   @relation(fields: [acteurId], references: [id])
  dateDebut    DateTime @db.Date
  dateFin      DateTime @db.Date
  dispositions String
  createdAt    DateTime @default(now())
}
